        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.86"
        android:scaleY="0.86">

        <group android:name="body">
            <clip-path android:pathData="M0,0 H108 V108 H0 Z M56.091,35.125 L51.649,63.848 A11.5,11.5 0 0,0 74.351,63.848 L69.909,35.125 A7,7 0 1,0 56.091,35.125 Z" />
            <path
                android:fillColor="#FFFFFFFF"
