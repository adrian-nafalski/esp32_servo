        </group>

        <path
            android:name="horn"
            android:fillColor="#FFFFFFFF"
            android:fillType="evenOdd"
            android:pathData="M58.558,34.723 A4.5,4.5 0 1,1 67.442,34.723 L71.883,63.446 A9,9 0 0,1 54.117,63.446 Z M59.8,62 a3.2,3.2 0 1,0 6.4,0 a3.2,3.2 0 1,0 -6.4,0 Z" />
    </group>
</vector>
