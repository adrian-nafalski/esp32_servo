<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Rodzic zależny od trybu: wariant ciemny w values-night/themes.xml. -->
    <style name="Base.Theme.Servo" parent="android:Theme.Material.Light.NoActionBar" />

    <!--
        Motyw aktywności jest jednocześnie motywem systemowego splash screena (API 31+).
        Nie potrzeba biblioteki core-splashscreen ani osobnej SplashActivity:
        minSdk = 31, więc wszystkie atrybuty android:windowSplashScreen* są dostępne natywnie.
    -->
    <style name="Theme.Servo" parent="Base.Theme.Servo">
        <item name="android:windowBackground">@color/servo_background</item>
        <item name="android:windowSplashScreenBackground">@color/servo_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/avd_splash_servo</item>
        <item name="android:windowSplashScreenAnimationDuration">@integer/splash_arm_duration_ms</item>
    </style>
</resources>
